{
  "info": {
    "name": "Fractional Commodity Ledger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the requests in order (or use the Collection Runner). Default auth: trader/trader123; ADMIN requests use admin/admin123."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{traderUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{traderPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "traderUser",
      "value": "trader"
    },
    {
      "key": "traderPassword",
      "value": "trader123"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "tradeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 List commodities",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/commodities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commodities"
          ]
        }
      }
    },
    {
      "name": "03 Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Reeck Demo\",\n  \"email\": \"demo-{{$timestamp}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Deposit INR 10,000",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}/wallet/deposit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}",
            "wallet",
            "deposit"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 10000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 Get wallet",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}/wallet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}",
            "wallet"
          ]
        }
      }
    },
    {
      "name": "06 Buy INR 2,000 of GOLD (by amount)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/buy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "buy"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"commodity\": \"GOLD\",\n  \"amount\": 2000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Wallet 10,000.00 -> 8,000.00; holding +0.16 g GOLD; ledger DEBIT USER_COMMODITY / CREDIT USER_CASH."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('tradeId', pm.response.json().trade.tradeId);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Buy 0.5 g SILVER (by quantity, with clientOrderId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/buy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "buy"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"commodity\": \"SILVER\",\n  \"quantity\": 0.5,\n  \"clientOrderId\": \"silver-order-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Retry same clientOrderId (idempotent, 200 + replayed=true)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/buy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "buy"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"commodity\": \"SILVER\",\n  \"quantity\": 0.5,\n  \"clientOrderId\": \"silver-order-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Portfolio",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}/portfolio",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}",
            "portfolio"
          ]
        }
      }
    },
    {
      "name": "10 ADMIN: raise GOLD price to 13,000",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/commodities/GOLD/price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commodities",
            "GOLD",
            "price"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pricePerUnit\": 13000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11 Sell INR 1,040 of GOLD (realises a profit)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/sell",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "sell"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"commodity\": \"GOLD\",\n  \"amount\": 1040\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 Withdraw INR 500",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}/wallet/withdraw",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}",
            "wallet",
            "withdraw"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 Trade history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}/trades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}",
            "trades"
          ]
        }
      }
    },
    {
      "name": "14 Get trade by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}"
          ]
        }
      }
    },
    {
      "name": "15 User ledger (all journals)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}/ledger",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}",
            "ledger"
          ]
        }
      }
    },
    {
      "name": "16 ADMIN: verify ledger integrity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ledger/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ledger",
            "verify"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "17 ADMIN: reset GOLD price to 12,500",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/commodities/GOLD/price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commodities",
            "GOLD",
            "price"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pricePerUnit\": 12500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "18 Error: insufficient funds (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/buy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "buy"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"commodity\": \"GOLD\",\n  \"amount\": 1000000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "19 Error: quantity AND amount (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/buy",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "buy"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"commodity\": \"GOLD\",\n  \"quantity\": 1,\n  \"amount\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "20 Error: trader cannot change prices (403)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/commodities/GOLD/price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commodities",
            "GOLD",
            "price"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pricePerUnit\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}